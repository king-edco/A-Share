# Base URL of the A-Share API, as reachable from the browser.
# Copy this file to .env for local development with `npm run dev`.
#
# Use the direct API origin when the API allows cross-origin requests:
VITE_API_URL=http://localhost:8000
#
# In the Docker Compose stack this is baked in as "/api" instead, and the
# web container's nginx proxies /api/* to the api service (same origin).
