# A-Share - Environment Variables
# Copy this file to .env and fill in real values locally.
# Do NOT commit .env to version control.

# Async SQLAlchemy connection string
# Example: postgresql+asyncpg://user:password@localhost:5432/dbname
DATABASE_URL=

# Secret used to sign admin JWTs. Use a long random string in real deployments.
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Credentials of the bootstrap admin account created by the seed script.
# There is no public registration; this is how the first admin is created.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-to-a-strong-password
